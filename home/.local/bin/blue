#!/usr/bin/env bash

message () {
	local bold; bold=$(tput bold)
	local norm; norm=$(tput sgr0)
	cat << EOF
${bold}USAGE${norm}: ${bold}$(basename "$0")${norm} [options]
${bold}OPTIONS${norm}:
        on               turn on bluetooth
        off              turn off bluetooth
        connect <NAME>   connect to bluetooth device
        status           show power status of bluetooth
EOF
}

case "$1" in
	on)
		blueutil -p 1 && exit 0
		;;
	off)
		blueutil -p 0 && exit 0
		;;
	status)
		blueutil && exit 0
		;;
	connect)
		[[ $# != 2 ]] && message >&2 && exit 1
		blueutil -p 1
		blueutil --connect "$2"
		exit 0
		;;
	*)
		message >&2
		exit 1
		;;
esac
